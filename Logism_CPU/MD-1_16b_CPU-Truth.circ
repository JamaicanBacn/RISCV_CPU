    <appear>
      <path d="M66,51 Q70,61 74,51" fill="none" stroke="#808080" stroke-width="2"/>
      <rect fill="none" height="186" stroke="#000000" stroke-width="2" width="100" x="50" y="50"/>
      <text font-family="SansSerif" font-size="12" text-anchor="middle" x="99" y="126">EEPROM</text>
      <text font-family="SansSerif" font-size="12" text-anchor="middle" x="101" y="138">2K * 8b</text>
      <text font-family="SansSerif" font-size="9" text-anchor="middle" x="69" y="103">ADR</text>
